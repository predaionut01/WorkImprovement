# Copiază în .env.local (ignorat de git). Fără nicio variabilă, pipeline-ul rulează offline (template + reguli).

# ---- Dialogflow CX (Conversational Agents) — platforma conversațională, primul furnizor în lanț ----
DF_PROJECT_ID=
DF_LOCATION=
DF_AGENT_ID=
DF_ENVIRONMENT=
DF_LANGUAGE=ro

# ---- Gemini pe Vertex AI — pentru ce Dialogflow nu acoperă (router fără CX, judges) și ca rezervă generativă ----
# Varianta recomandată: Vertex AI cu Application Default Credentials (`gcloud auth application-default login`)
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Alternativ (dezvoltare): cheie Gemini Developer API din Google AI Studio
GEMINI_API_KEY=
# Modele (opțional): implicit gemini-3.1-pro-preview / gemini-3.8-flash
GEMINI_MODEL_MAIN=
GEMINI_MODEL_SMALL=

# ---- Gateway ----
# Lanț de furnizori (implicit): dialogflow,gemini-pro,gemini-flash,dev-http,template
HB_PROVIDER_CHAIN=
# Forțează modul offline (șablon + reguli), util pentru demo fără credențiale / scripts/chat-smoke.ts
HB_FORCE_OFFLINE=
# Întârziere (ms) între bucățile streamate de șablonul offline (implicit 18)
HB_TEMPLATE_DELAY_MS=
# URL public al VA API, folosit în openapi.json (implicit originea cererii)
HB_PUBLIC_URL=

# ---- Hook dev-http (DOAR dezvoltare locală individuală) ----
# Dacă e setat, gateway-ul trimite promptul la acest URL (protocol în src/lib/pipeline/devHttp.ts).
# Repo-ul nu știe ce rulează în spate; nu seta pe workstation-ul echipei.
HB_DEV_PROVIDER_URL=
